# ─────────────────────────────────────────────────────────────
# Orbis Collector — Configuration (Windows)
# Éditez ce fichier puis redémarrez le service :
#   sc stop OrbisCollector && sc start OrbisCollector
# ─────────────────────────────────────────────────────────────

# Obligatoire : URL de l'API Orbis
ORBIS_API_URL=https://app.orbis.local/api

# Obligatoire : ID du collector (visible dans l'app, onglet Collectors)
ORBIS_COLLECTOR_ID=

# Obligatoire : token d'authentification (généré dans l'app)
ORBIS_COLLECTOR_TOKEN=

# Optionnel : nom d'affichage
ORBIS_COLLECTOR_NAME=

# CIDRs à scanner (séparés par virgules). Ex : 192.168.1.0/24,10.0.0.0/24
ORBIS_CIDRS=

# Intervalle de scan en secondes (défaut : 900 = 15 min)
ORBIS_INTERVAL_SECONDS=900

# Ports à scanner (séparés par virgules)
ORBIS_PORTS=22,80,443,445,3389,8080,9100

# SNMP communautés v2c (séparées par virgules)
ORBIS_SNMP_COMMUNITIES=public

# SNMP v3 (optionnel)
ORBIS_SNMPV3_USERNAME=
ORBIS_SNMPV3_LEVEL=
ORBIS_SNMPV3_AUTH_PROTOCOL=
ORBIS_SNMPV3_AUTH_PASSWORD=
ORBIS_SNMPV3_PRIV_PROTOCOL=
ORBIS_SNMPV3_PRIV_PASSWORD=
