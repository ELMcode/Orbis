# ─────────────────────────────────────────────────────────────
# Orbis - Environment variables (copy to .env)
# ─────────────────────────────────────────────────────────────

# PostgreSQL database
POSTGRES_PASSWORD="change-this-to-a-long-random-password"
DATABASE_URL="postgresql://orbis:orbis@localhost:5432/orbis?schema=public"

# JWT secret - REQUIRED to change in production (minimum 32 characters)
JWT_ACCESS_SECRET="change-me-access-secret-please-use-a-long-random-string"
JWT_REFRESH_SECRET="change-me-refresh-secret-please-use-a-long-random-string"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Serveur
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
APP_URL="http://localhost:5173"
# Public URL when Docker Compose is used (SSO, password reset, billing).
PUBLIC_APP_URL="http://localhost:8080"

# Upload storage (relative to packages/backend)
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=20
INTEGRATION_ENCRYPTION_KEY="base64-encoded-32-byte-key"

# Security / networking
CORS_ORIGINS=""
TRUST_PROXY=false
METRICS_TOKEN=""
# In production: set a long, unique token for /metrics.

# Email transactionnel (reset mot de passe, invitations)
EMAIL_FROM="Orbis <noreply@example.com>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
PASSWORD_RESET_TTL_MINUTES=30

# Stripe Billing
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
STRIPE_SUCCESS_URL=""
STRIPE_CANCEL_URL=""

# WorkOS SSO
WORKOS_CLIENT_ID=""
WORKOS_REDIRECT_URI=""

# Cloud and hypervisor credential vault: 32 base64-encoded bytes.
# Generate with: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=""
# Allow webhooks to private networks (on-premises/dev only).
# In SaaS production, leave this false or empty.
ALLOW_PRIVATE_OUTBOUND_URLS=false

# OpenTelemetry observability (optional; an HTTPS OTLP endpoint is recommended).
OTEL_EXPORTER_OTLP_ENDPOINT=""

# Seed volontaire uniquement
SEED_ON_START=false
