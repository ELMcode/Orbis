# ─────────────────────────────────────────────────────────────
# Orbis Collector — Configuration (Windows)
# Edit this file, then restart the service:
#   sc stop OrbisCollector && sc start OrbisCollector
# ─────────────────────────────────────────────────────────────

# Obligatoire : URL de l'API Orbis
ORBIS_API_URL=https://app.orbis.local/api

# Required: collector ID (visible in the application, Collectors tab).
ORBIS_COLLECTOR_ID=

# Required: authentication token (generated in the application).
ORBIS_COLLECTOR_TOKEN=

# Optional: display name.
ORBIS_COLLECTOR_NAME=

# CIDRs to scan (comma-separated). Example: 192.168.1.0/24,10.0.0.0/24
ORBIS_CIDRS=

# Scan interval in seconds (default: 900 = 15 minutes).
ORBIS_INTERVAL_SECONDS=900

# Ports to scan (comma-separated).
ORBIS_PORTS=22,80,443,445,3389,8080,9100

# SNMP v2c communities (comma-separated).
ORBIS_SNMP_COMMUNITIES=public

# SNMP v3 (optional).
ORBIS_SNMPV3_USERNAME=
ORBIS_SNMPV3_LEVEL=
ORBIS_SNMPV3_AUTH_PROTOCOL=
ORBIS_SNMPV3_AUTH_PASSWORD=
ORBIS_SNMPV3_PRIV_PROTOCOL=
ORBIS_SNMPV3_PRIV_PASSWORD=
