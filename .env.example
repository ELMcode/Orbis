# ─────────────────────────────────────────────────────────────
# Orbis — Variables d'environnement (copier en .env)
# ─────────────────────────────────────────────────────────────

# Base de données PostgreSQL
POSTGRES_PASSWORD="change-this-to-a-long-random-password"
DATABASE_URL="postgresql://orbis:orbis@localhost:5432/orbis?schema=public"

# Secret JWT — OBLIGATOIRE à changer en production (min 32 caractères)
JWT_ACCESS_SECRET="change-me-access-secret-please-use-a-long-random-string"
JWT_REFRESH_SECRET="change-me-refresh-secret-please-use-a-long-random-string"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Serveur
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
APP_URL="http://localhost:5173"
# URL publique lorsque Docker Compose est utilisé (SSO, reset, billing).
PUBLIC_APP_URL="http://localhost:8080"

# Stockage des uploads (relatif à packages/backend)
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=20
INTEGRATION_ENCRYPTION_KEY="base64-encoded-32-byte-key"

# Sécurité / réseau
CORS_ORIGINS=""
TRUST_PROXY=false
METRICS_TOKEN=""
# En production : définir un jeton long et non réutilisé pour /metrics.

# Email transactionnel (reset mot de passe, invitations)
EMAIL_FROM="Orbis <noreply@example.com>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
PASSWORD_RESET_TTL_MINUTES=30

# Stripe Billing
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
STRIPE_SUCCESS_URL=""
STRIPE_CANCEL_URL=""

# WorkOS SSO
WORKOS_CLIENT_ID=""
WORKOS_REDIRECT_URI=""

# Coffre d'identifiants cloud/hyperviseurs : 32 octets encodés base64.
# Génération : openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=""
# Autoriser des webhooks vers des réseaux privés (uniquement on-prem/dev).
# En production SaaS, laisser à false ou vide.
ALLOW_PRIVATE_OUTBOUND_URLS=false

# Observabilité OpenTelemetry (optionnel, endpoint OTLP HTTPS recommandé).
OTEL_EXPORTER_OTLP_ENDPOINT=""

# Seed volontaire uniquement
SEED_ON_START=false
