ORBIS_API_URL=https://orbis.example.com
ORBIS_COLLECTOR_ID=replace-with-collector-id
ORBIS_COLLECTOR_TOKEN=replace-with-token
ORBIS_CIDRS=192.168.1.0/24
ORBIS_PORTS=22,80,443,445,3389,8080,8443,9100
ORBIS_INTERVAL_SECONDS=900
ORBIS_TIMEOUT_MS=900
ORBIS_SNMP_TIMEOUT_MS=900

# Optional SNMPv2c
# ORBIS_SNMP_COMMUNITIES=public,supervision

# Optional SNMPv3
# ORBIS_SNMPV3_USERNAME=snmp-reader
# ORBIS_SNMPV3_LEVEL=authPriv
# ORBIS_SNMPV3_AUTH_PROTOCOL=sha256
# ORBIS_SNMPV3_AUTH_PASSWORD=change-me
# ORBIS_SNMPV3_PRIV_PROTOCOL=aes
# ORBIS_SNMPV3_PRIV_PASSWORD=change-me
